C G0-grace-production-seqcst
(* The grace points at the production strength grace::Sequential: pin store, observation load, removal store, era bump, start_era load and pin load all SeqCst, with empty fences.
   Events: P0 is the reader, its pin store to pin then its observation
   load of bucket; P1 is the writer, its removal store to bucket then its
   era bump; P2 is the maintainer, its start_era load then its pin load.
   Pinned reader missed: 0:r0=1 (the reader saw the entry), 2:r0=2 (the
   pass started after the bump) and 2:r1=0 (the pass saw no pin). *)
{ pin = 0; bucket = 1; era = 1; }

P0 (atomic_int* pin, atomic_int* bucket) {
  atomic_store_explicit(pin, 1, memory_order_seq_cst);
  int r0 = atomic_load_explicit(bucket, memory_order_seq_cst);
}

P1 (atomic_int* bucket, atomic_int* era) {
  atomic_store_explicit(bucket, 0, memory_order_seq_cst);
  int r0 = atomic_fetch_add_explicit(era, 1, memory_order_seq_cst);
}

P2 (atomic_int* era, atomic_int* pin) {
  int r0 = atomic_load_explicit(era, memory_order_seq_cst);
  int r1 = atomic_load_explicit(pin, memory_order_seq_cst);
}

exists (0:r0=1 /\ 2:r0=2 /\ 2:r1=0)
