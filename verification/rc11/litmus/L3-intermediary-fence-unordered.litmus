C L3-intermediary-fence-unordered
(* An unfenced credit::park (P0), a fenced scan (P1) and a third thread (P2)
   that acquires P0's add and then issues a seq_cst fence hb-unordered with
   P1's. P2 is no credit operation: it asks whether a third thread's fence
   stands in for P0's missing one. Hidden credit
   with P2 having seen the add: 0:r0=1, 1:r0=0 and 2:r0=1. *)
{ x = 0; y = 1; }

P0 (atomic_int* x, atomic_int* y) {
  atomic_fetch_add_explicit(x, 1, memory_order_release);
  int r0 = atomic_load_explicit(y, memory_order_acquire);
}

P1 (atomic_int* x, atomic_int* y) {
  atomic_fetch_and_explicit(y, 0, memory_order_acq_rel);
  atomic_thread_fence(memory_order_seq_cst);
  int r0 = atomic_load_explicit(x, memory_order_acquire);
}

P2 (atomic_int* x) {
  int r0 = atomic_load_explicit(x, memory_order_acquire);
  atomic_thread_fence(memory_order_seq_cst);
}

exists (0:r0=1 /\ 1:r0=0 /\ 2:r0=1)
