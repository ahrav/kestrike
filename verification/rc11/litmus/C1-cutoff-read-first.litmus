C C1-cutoff-read-first
(* The control: the cutoff load before the pin store, every access SeqCst.
   Live pin missed: 0:r0=0 (the entry read the cutoff open), 2:r0=1 (the
   scan ran after the close) and 2:r1=0 (the scan saw no pin).
   Events: P0 is the entrant, its cutoff load then its pin store; P1 is
   the closer's cutoff store; P2 is the scanner after the close, its
   cutoff load then its visit's pin load. *)
{ pin = 0; closed = 0; }

P0 (atomic_int* pin, atomic_int* closed) {
  int r0 = atomic_load_explicit(closed, memory_order_seq_cst);
  atomic_store_explicit(pin, 1, memory_order_seq_cst);
}

P1 (atomic_int* closed) {
  atomic_store_explicit(closed, 1, memory_order_seq_cst);
}

P2 (atomic_int* closed, atomic_int* pin) {
  int r0 = atomic_load_explicit(closed, memory_order_seq_cst);
  int r1 = atomic_load_explicit(pin, memory_order_seq_cst);
}

exists (0:r0=0 /\ 2:r0=1 /\ 2:r1=0)
