C L6-production-seqcst-accesses
(* The credit shape at the production strength credit::Sequential: park's
   fetch_add and bit load and the scan's fetch_and and reload all SeqCst,
   with empty fences. Hidden credit: 0:r0=1 and 1:r0=0. *)
{ x = 0; y = 1; }

P0 (atomic_int* x, atomic_int* y) {
  atomic_fetch_add_explicit(x, 1, memory_order_seq_cst);
  int r0 = atomic_load_explicit(y, memory_order_seq_cst);
}

P1 (atomic_int* x, atomic_int* y) {
  atomic_fetch_and_explicit(y, 0, memory_order_seq_cst);
  int r0 = atomic_load_explicit(x, memory_order_seq_cst);
}

exists (0:r0=1 /\ 1:r0=0)
