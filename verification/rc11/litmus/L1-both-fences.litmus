C L1-both-fences
(* The credit shape with both model fences, credit_model's Model<true, true>,
   the model's stand-in for production. P0 is credit::park with
   Strength::fence_park between its Release add and Acquire bit load; P1 is
   the scan with Strength::fence_clear between its AcqRel clear and Acquire
   reload. Hidden credit: 0:r0=1 (stale bit) and 1:r0=0 (stale word). *)
{ x = 0; y = 1; }

P0 (atomic_int* x, atomic_int* y) {
  atomic_fetch_add_explicit(x, 1, memory_order_release);
  atomic_thread_fence(memory_order_seq_cst);
  int r0 = atomic_load_explicit(y, memory_order_acquire);
}

P1 (atomic_int* x, atomic_int* y) {
  atomic_fetch_and_explicit(y, 0, memory_order_acq_rel);
  atomic_thread_fence(memory_order_seq_cst);
  int r0 = atomic_load_explicit(x, memory_order_acquire);
}

exists (0:r0=1 /\ 1:r0=0)
