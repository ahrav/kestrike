C L7-mixed-seqcst-rmw-vs-fenced
(* Mixed strength: P0 is credit::park at credit::Sequential (SeqCst accesses,
   no fence) and P1 is the model's fenced scan (AcqRel clear, seq_cst fence,
   Acquire reload). Asks whether an SC access pair and a fence pair compose
   under RC11's psc. Hidden credit: 0:r0=1 and 1:r0=0. *)
{ x = 0; y = 1; }

P0 (atomic_int* x, atomic_int* y) {
  atomic_fetch_add_explicit(x, 1, memory_order_seq_cst);
  int r0 = atomic_load_explicit(y, memory_order_seq_cst);
}

P1 (atomic_int* x, atomic_int* y) {
  atomic_fetch_and_explicit(y, 0, memory_order_acq_rel);
  atomic_thread_fence(memory_order_seq_cst);
  int r0 = atomic_load_explicit(x, memory_order_acquire);
}

exists (0:r0=1 /\ 1:r0=0)
